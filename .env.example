# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# PHP version: any official php:<version>-fpm-alpine tag, e.g. 7.4, 8.1, 8.2, 8.3, 8.4, 8.5
PHP_VERSION=8.4
MYSQL_VERSION=8.4

# Folder mounted as the web root's parent; nginx serves $APP_DIR/public
APP_DIR=app

MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

TZ=UTC

# Host ports. MySQL and phpMyAdmin are only published on 127.0.0.1.
# Set HTTP_BIND=0.0.0.0 to reach the site from other devices on your network.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
MYSQL_PORT=3306
PMA_PORT=8081
MAILPIT_PORT=8025
REDIS_PORT=6379

# Set to true and rebuild (docker compose build php) to enable Xdebug
INSTALL_XDEBUG=false

# Linux: set these to the output of `id -u` / `id -g` so generated files are owned by you
UID=1000
GID=1000
